{
  "name": "os-june",
  "version": "1.58.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "node scripts/tauri-build.mjs",
    "tauri:build:signed-dmg": "./scripts/build-signed-dmg.sh",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:check": "node scripts/coverage-floor.mjs check frontend coverage/frontend/coverage-summary.json",
    "coverage:raise": "node scripts/coverage-floor.mjs raise frontend coverage/frontend/coverage-summary.json",
    "changelog": "node scripts/generate-release-changelog.mjs",
    "test:ui": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --all-targets --html --output-dir src-tauri/target/llvm-cov/html",
    "test:june-api": "cd june-api && cargo test --all-targets --all-features --locked -- --test-threads=1",
    "test:june-api:coverage": "cd june-api && cargo llvm-cov --workspace --all-features --html --output-dir target/llvm-cov/html",
    "test:hermes-smoke": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/hermes-smoke.ts",
    "hermes:upgrade-check": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/hermes-upgrade-check.ts",
    "version:bump": "node scripts/bump-version.mjs",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-haptics": "^2.3.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tiptap/extension-highlight": "3.31.0",
    "@tiptap/extension-list": "3.31.0",
    "@tiptap/extension-mention": "3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "@tiptap/suggestion": "3.31.0",
    "@xyflow/react": "^12.11.6",
    "border-beam": "^1.3.0",
    "central-icons": "npm:@central-icons-react/round-outlined-radius-3-stroke-2@1.1.233",
    "central-icons-filled": "npm:@central-icons-react/round-filled-radius-3-stroke-2@1.1.241",
    "framer-motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unicode-animations": "^1.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "agentation": "^3.0.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "@central-icons-react/round-outlined-radius-3-stroke-2",
      "@central-icons-react/round-filled-radius-3-stroke-2"
    ]
  }
}
