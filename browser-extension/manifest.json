{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Sub Rosa",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "nativeMessaging",
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup.html",
    "default_icon": {
      "32": "icons/32.png",
      "64": "icons/64.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      }
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-extension@subrosa.carpediem.xyz",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
