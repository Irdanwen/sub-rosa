{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "website/src/**",
      "packages/chat-core/src/**",
      "website/scripts/**",
      "website/*.ts",
      "website/*.json",
      "browser-extension/src/**",
      "browser-extension/scripts/**",
      "browser-extension/*.json",
      "office-addins/src/**",
      "office-addins/scripts/**",
      "office-addins/*.ts",
      "office-addins/*.json",
      "*.json",
      "*.ts",
      "*.mjs",
      "!**/*.min.js",
      "!src/lib/studio/workflow/step-catalog.json",
      "!src/test/fixtures/comfy-corpus",
      "!**/dist",
      "!**/node_modules"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": {
        "noAriaHiddenOnFocusable": "warn",
        "noAutofocus": "warn",
        "noLabelWithoutControl": "warn",
        "noNoninteractiveElementToInteractiveRole": "warn",
        "noNoninteractiveTabindex": "warn",
        "noRedundantRoles": "warn",
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn",
        "useAriaPropsForRole": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useFocusableInteractive": "warn",
        "useKeyWithClickEvents": "warn",
        "useMediaCaption": "warn",
        "useSemanticElements": "warn",
        "useValidAnchor": "warn"
      },
      "correctness": {
        "noUnusedImports": "error",
        "useExhaustiveDependencies": {
          "level": "warn",
          "options": {
            "hooks": [
              {
                "name": "useSessionActivity",
                "stableResult": [
                  "workingSessionIdsRef",
                  "waitingSessionIdsRef",
                  "toolCallSessionIdsRef",
                  "activeToolCallsBySessionRef",
                  "setSessionWorking",
                  "setSessionWaiting",
                  "setSessionToolCallActive",
                  "clearSessionActivity"
                ]
              },
              {
                "name": "useHermesGateways",
                "stableResult": ["gatewaysRef", "gatewayCloseHandlerRef", "runtimeSessionIdsRef"]
              },
              {
                "name": "useLiveEventBuffer",
                "stableResult": ["liveEventsRef", "liveEventsPublisher"]
              },
              {
                "name": "useSessionStream",
                "stableResult": ["sessionGatewayUnlistenRef", "pendingSteerBySessionIdRef"]
              }
            ]
          }
        }
      },
      "suspicious": {
        "noConsole": "warn",
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "noConfusingVoidType": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "noDescendingSpecificity": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "lucide-react": "Use central-icons / central-icons-filled only (see spec/icons-central-only.md).",
              "lucide": "Use central-icons / central-icons-filled only (see spec/icons-central-only.md)."
            }
          }
        }
      },
      "complexity": {
        "noImportantStyles": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
