{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window access to scoped June commands.",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "deep-link:default",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "process:allow-restart",
    "autostart:default"
  ]
}
