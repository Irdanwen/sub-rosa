{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chat-bar",
  "description": "Chat bar access to its own panel, events, and the agent runtime's gateway (ADR-0094).",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "chat-bar"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:allow-unlisten",
    "core:window:allow-hide",
    "core:window:allow-show"
  ]
}
