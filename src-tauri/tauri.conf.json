{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sub Rosa",
  "version": "1.49.3",
  "identifier": "xyz.carpediem.subrosa",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Sub Rosa",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      },
      {
        "label": "hud",
        "url": "/hud.html",
        "title": "Sub Rosa Dictation",
        "width": 124,
        "height": 32,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false
      },
      {
        "label": "agent-hud",
        "url": "/agent-hud.html",
        "title": "Sub Rosa Agents",
        "width": 240,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focusable": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "meeting-hud",
        "url": "/meeting-hud.html",
        "title": "Sub Rosa Recording",
        "width": 76,
        "height": 76,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'sha256-5zseCXEQXMrhVnLDc5/8D6srY3KbB1TDtKXlkC9HSao='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; media-src 'self' asset: http://asset.localhost data: blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/os-june-dictation-*.m4a",
          "$APPDATA/studio-media/*"
        ]
      },
      "capabilities": [
        "main",
        "hud",
        "agent-hud",
        "meeting-hud"
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "subrosa"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "subrosa"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCNzc2Njk1MUU4NTRBNEUKUldST1NvVWVsV1ozT3h4dzRKRXVDeXErSjJ6a0kyelFSZjNjejJBVTJpc2h6bG13K0Q2NVZ0cUkK",
      "endpoints": [
        "https://github.com/Irdanwen/sub-rosa-releases/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/june-api"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../.tauri-hermes/hermes": "native/hermes",
      "../june-api/config.toml": "config.toml",
      "../.agents/skills/carpe-diem-api-overview": "skills/carpe-diem-api-overview",
      "../.agents/skills/carpe-diem-audio-music": "skills/carpe-diem-audio-music",
      "../.agents/skills/carpe-diem-audio-speech": "skills/carpe-diem-audio-speech",
      "../.agents/skills/carpe-diem-audio-transcription": "skills/carpe-diem-audio-transcription",
      "../.agents/skills/carpe-diem-auth": "skills/carpe-diem-auth",
      "../.agents/skills/carpe-diem-chat": "skills/carpe-diem-chat",
      "../.agents/skills/carpe-diem-credits": "skills/carpe-diem-credits",
      "../.agents/skills/carpe-diem-embeddings": "skills/carpe-diem-embeddings",
      "../.agents/skills/carpe-diem-errors": "skills/carpe-diem-errors",
      "../.agents/skills/carpe-diem-image-edit": "skills/carpe-diem-image-edit",
      "../.agents/skills/carpe-diem-image-generate": "skills/carpe-diem-image-generate",
      "../.agents/skills/carpe-diem-media": "skills/carpe-diem-media",
      "../.agents/skills/carpe-diem-models": "skills/carpe-diem-models",
      "../.agents/skills/carpe-diem-provider": "skills/carpe-diem-provider",
      "../.agents/skills/carpe-diem-video": "skills/carpe-diem-video",
      "../.agents/skills/remotion-best-practices": "skills/remotion-best-practices"
    }
  }
}
