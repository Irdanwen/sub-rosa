# Replace the hostnames only after DNS, OIDC callback and public_url are configured.
account.example.invalid {
    encode zstd gzip
    request_body {
        max_size 33MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    @site not path /app /app/* /connector-view.html /office/courier.html /office/moved.html /python-sandbox.html
    header @site {
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://carpe-diem.xyz; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; require-trusted-types-for 'script'; trusted-types subrosa"
    }
    # The web client (ADR-0101, WP20b): see nginx-account.conf.example.
    @app path /app /app/*
    header @app {
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://carpe-diem.xyz https://huggingface.co https://mcp.intercom.com https://mcp.linear.app https://mcp.notion.com https://mcp.squareup.com https://mcp.webflow.com; worker-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; require-trusted-types-for 'script'; trusted-types subrosa"
    }
    # The Office add-ins run on their own origin (ADR-0102, addendum of
    # 2026-10-10; the office block below): see nginx-account.conf.example.
    @courier path /office/courier.html
    header @courier {
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; frame-ancestors https://office.example.invalid; require-trusted-types-for 'script'; trusted-types 'none'"
        Cache-Control "no-store"
    }
    @signedin path /office/signed-in.html
    header @signedin Cache-Control "no-store"
    @moved path /office/moved.html
    header @moved {
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://*.officeapps.live.com https://*.office.com https://*.office365.com https://*.cloud.microsoft https://*.sharepoint.com https://onedrive.live.com"
    }
    @officeold path /office/word.html /office/excel.html /office/powerpoint.html /office/session.html /office/commands.html
    redir @officeold /office/moved.html 308
    @officeother {
        path /office/*
        not path /office/courier.html /office/signed-in.html /office/moved.html
    }
    handle @officeother {
        respond 404
    }
    @view path /connector-view.html
    header @view {
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' https:; style-src 'unsafe-inline' https:; img-src data: blob: https:; font-src data: https:; media-src data: blob: https:; connect-src https:; frame-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'"
        Cache-Control "no-store"
    }

    # The Python sandbox (ADR-0104 addendum of 2026-10-10), framed by /app
    # alone: see nginx-account.conf.example. Replace the origin with the
    # site's own.
    @sandbox path /python-sandbox.html
    header @sandbox {
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'none'; script-src https://account.example.invalid/assets/ https://account.example.invalid/pyodide/ 'wasm-unsafe-eval'; worker-src data: https://account.example.invalid/assets/; connect-src https://account.example.invalid/pyodide/; frame-ancestors https://account.example.invalid; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types subrosa-python"
        Cache-Control "no-store"
    }
    @sandboxed path /assets/python-sandbox* /pyodide/*
    header @sandboxed Access-Control-Allow-Origin "*"
    @service path /api/* /auth/* /livez /readyz
    handle @service {
        reverse_proxy subrosa-cloud:8088
    }
    @association path /.well-known/apple-app-site-association /.well-known/assetlinks.json
    handle @association {
        root * /srv/website
        header Content-Type application/json
        file_server
    }
    handle {
        root * /srv/website
        try_files {path} /index.html
        file_server
    }
}

# The Office add-ins' own origin (ADR-0102, addendum of 2026-10-10): static
# files from office-addins/dist, no service, no cookie. See
# nginx-office.conf.example.
office.example.invalid {
    encode zstd gzip
    request_body {
        max_size 1KB
    }
    request_header -Cookie
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Set-Cookie
    }
    @office path /office/*
    header @office {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://appsforoffice.microsoft.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://carpe-diem.xyz; worker-src 'self' blob:; frame-src 'self' https://appsforoffice.microsoft.com https://account.example.invalid/office/courier.html; object-src 'none'; base-uri 'none'; frame-ancestors https://*.officeapps.live.com https://*.office.com https://*.office365.com https://*.cloud.microsoft https://*.sharepoint.com https://onedrive.live.com; form-action 'self'; require-trusted-types-for 'script'; trusted-types subrosa officejs"
    }
    # The Excel pane's Python sandbox (ADR-0104 addendum of 2026-10-10), this
    # origin's own copy: see nginx-office.conf.example.
    @sandbox path /python-sandbox.html
    header @sandbox {
        Content-Security-Policy "default-src 'none'; script-src https://office.example.invalid/office/assets/ https://office.example.invalid/pyodide/ 'wasm-unsafe-eval'; worker-src data: https://office.example.invalid/office/assets/; connect-src https://office.example.invalid/pyodide/; frame-ancestors https://office.example.invalid https://*.officeapps.live.com https://*.office.com https://*.office365.com https://*.cloud.microsoft https://*.sharepoint.com https://onedrive.live.com; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types subrosa-python"
        Cache-Control "no-store"
    }
    @pyodide path /pyodide/*
    header @pyodide {
        X-Frame-Options "DENY"
        Cache-Control "public, max-age=604800"
    }
    @sandboxed path /office/assets/python-sandbox* /pyodide/*
    header @sandboxed Access-Control-Allow-Origin "*"
    @files path /office/* /pyodide/* /python-sandbox.html
    handle @files {
        root * /srv/office
        file_server
    }
    handle {
        respond 404
    }
}

# Public pages (ADR 0097): their own origin, never the account's. Only the
# three public prefixes reach the service, which sends each page its own
# Content-Security-Policy and refuses them on any other Host.
pages.example.invalid {
    encode zstd gzip
    request_body {
        max_size 16KB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Set-Cookie
    }
    @public path /p/* /u/* /_pub/*
    handle @public {
        request_header -Cookie
        reverse_proxy subrosa-cloud:8088
    }
    handle {
        respond 404
    }
}
