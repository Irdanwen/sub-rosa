# Replace the hostname only after DNS, OIDC callback and public_url are configured.
account.example.invalid {
    encode zstd gzip
    request_body {
        max_size 33MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    @site not path /app /app/* /connector-view.html /office/*
    header @site {
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://carpe-diem.xyz; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; require-trusted-types-for 'script'; trusted-types subrosa"
    }
    # The web client (ADR-0101, WP20b): see nginx-account.conf.example.
    @app path /app /app/*
    header @app {
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://carpe-diem.xyz https://huggingface.co https://mcp.intercom.com https://mcp.linear.app https://mcp.notion.com https://mcp.squareup.com https://mcp.webflow.com; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; require-trusted-types-for 'script'; trusted-types subrosa"
    }
    # The Office task panes (ADR-0102): see nginx-account.conf.example.
    @office path /office/*
    header @office {
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://appsforoffice.microsoft.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://carpe-diem.xyz; worker-src 'self' blob:; frame-src https://appsforoffice.microsoft.com; object-src 'none'; base-uri 'none'; frame-ancestors https://*.officeapps.live.com https://*.office.com https://*.office365.com https://*.cloud.microsoft https://*.sharepoint.com https://onedrive.live.com; form-action 'self'; require-trusted-types-for 'script'; trusted-types subrosa officejs"
    }
    @view path /connector-view.html
    header @view {
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' https:; style-src 'unsafe-inline' https:; img-src data: blob: https:; font-src data: https:; media-src data: blob: https:; connect-src https:; frame-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'"
        Cache-Control "no-store"
    }
    @service path /api/* /auth/* /livez /readyz
    handle @service {
        reverse_proxy subrosa-cloud:8088
    }
    @association path /.well-known/apple-app-site-association /.well-known/assetlinks.json
    handle @association {
        root * /srv/website
        header Content-Type application/json
        file_server
    }
    handle {
        root * /srv/website
        try_files {path} /index.html
        file_server
    }
}

# Public pages (ADR 0097): their own origin, never the account's. Only the
# three public prefixes reach the service, which sends each page its own
# Content-Security-Policy and refuses them on any other Host.
pages.example.invalid {
    encode zstd gzip
    request_body {
        max_size 16KB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Set-Cookie
    }
    @public path /p/* /u/* /_pub/*
    handle @public {
        request_header -Cookie
        reverse_proxy subrosa-cloud:8088
    }
    handle {
        respond 404
    }
}
