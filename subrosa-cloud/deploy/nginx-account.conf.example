# Account origin. Like Caddyfile.example, this file names a placeholder host:
# substitute the real account hostname when installing, for example
#   sed 's/account.example.invalid/<account host>/g' nginx-account.conf.example \
#     > /etc/nginx/sites-available/subrosa-account
# The account website at the root, the account service under
# /api, /auth, /livez and /readyz, and Keycloak's consumer endpoints under /id.
# This is the proxy contract of docs/vps-account-stack.md: HTTPS terminates
# here, no Docker port is public, X-Forwarded-* are replaced, Host is exact,
# and Keycloak's admin, master-realm and management paths never leave the host.
# Enable only after DNS, the certificate and the account stack exist. Nginx
# stays managed separately from the stack; never edit another application's vhost.

limit_req_zone $binary_remote_addr zone=subrosa_account:10m rate=10r/s;

server {
    listen 80;
    listen [::]:80;
    server_name account.example.invalid;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }
    location / { return 308 https://account.example.invalid$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name account.example.invalid;
    ssl_certificate /etc/letsencrypt/live/account.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/account.example.invalid/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # The account website is built with VITE_ACCOUNT_ORIGIN=https://account.example.invalid
    # and a root base, and published as its own release directory, apart from the
    # marketing subpath under /srv/subrosa.
    root /srv/subrosa-account/www/current;
    server_tokens off;
    # Query strings carry OIDC state; cookies and Authorization carry sessions.
    access_log off;
    client_max_body_size 33m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 60s;

    # Association documents must answer at their exact path as JSON. The SPA
    # fallback would otherwise return index.html with status 200 to OS verifiers.
    location = /.well-known/apple-app-site-association {
        default_type application/json;
        try_files $uri =404;
    }
    location = /.well-known/assetlinks.json {
        default_type application/json;
        try_files $uri =404;
    }

    # Account service (loopback only; PROXY_TRUSTED_ADDRESSES names this proxy).
    location ~ ^/(api|auth)/ {
        limit_req zone=subrosa_account burst=30 nodelay;
        proxy_pass http://127.0.0.1:18088;
    }
    location = /livez { proxy_pass http://127.0.0.1:18088; }
    location = /readyz { proxy_pass http://127.0.0.1:18088; }

    # Keycloak: consumer endpoints only. Administration goes through a private
    # tunnel to 127.0.0.1:18080, never through this vhost.
    location ^~ /id/admin/ { return 404; }
    location ^~ /id/realms/master/ { return 404; }
    location ^~ /id/metrics { return 404; }
    location ^~ /id/health { return 404; }
    location ^~ /id/realms/subrosa/ {
        limit_req zone=subrosa_account burst=30 nodelay;
        proxy_pass http://127.0.0.1:18080;
    }
    location ^~ /id/resources/ { proxy_pass http://127.0.0.1:18080; }
    location ^~ /id/js/ { proxy_pass http://127.0.0.1:18080; }
    location ^~ /id/ { return 404; }

    # Account website. The CSP applies to our pages only: Keycloak's pages send
    # their own, and add_header in a location replaces the inherited set, so the
    # five headers above are repeated here on purpose.
    location / {
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://carpe-diem.xyz; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; require-trusted-types-for 'script'; trusted-types subrosa" always;
        try_files $uri $uri/ /index.html;
    }

    # The web client (ADR-0101, WP20b) has its own policy: the site's plus
    # WebAssembly and a blob worker for Python (ADR-0086), the catalog's
    # connector origins a tab may call, the connector view host as a frame,
    # and the microphone, camera and screen for voice. `rewrite ... break`
    # serves the page from this location, so these headers are the ones sent.
    location = /app {
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://carpe-diem.xyz https://huggingface.co https://mcp.intercom.com https://mcp.linear.app https://mcp.notion.com https://mcp.squareup.com https://mcp.webflow.com; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; require-trusted-types-for 'script'; trusted-types subrosa" always;
        rewrite ^ /index.html break;
    }
    location ^~ /app/ {
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://carpe-diem.xyz https://huggingface.co https://mcp.intercom.com https://mcp.linear.app https://mcp.notion.com https://mcp.squareup.com https://mcp.webflow.com; worker-src 'self' blob:; frame-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; require-trusted-types-for 'script'; trusted-types subrosa" always;
        rewrite ^ /index.html break;
    }
    # A connector's interactive view (ADR-0092), framed sandboxed by /app.
    location = /connector-view.html {
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' https:; style-src 'unsafe-inline' https:; img-src data: blob: https:; font-src data: https:; media-src data: blob: https:; connect-src https:; frame-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'" always;
        add_header Cache-Control no-store always;
        try_files $uri =404;
    }

    # The Office task panes (ADR-0102). Office on the web frames them, so no
    # X-Frame-Options and a frame-ancestors naming Office's hosts; Office.js
    # comes from Microsoft's CDN and loads its files through its own "officejs"
    # Trusted Types policy; the Excel pane runs Python like /app.
    location ^~ /office/ {
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://appsforoffice.microsoft.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://carpe-diem.xyz; worker-src 'self' blob:; frame-src https://appsforoffice.microsoft.com; object-src 'none'; base-uri 'none'; frame-ancestors https://*.officeapps.live.com https://*.office.com https://*.office365.com https://*.cloud.microsoft https://*.sharepoint.com https://onedrive.live.com; form-action 'self'; require-trusted-types-for 'script'; trusted-types subrosa officejs" always;
        try_files $uri =404;
    }
    # Pyodide's files (ADR-0086), with types a module worker accepts.
    location ^~ /pyodide/ {
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Cache-Control "public, max-age=604800" always;
        types {
            text/javascript mjs js;
            application/wasm wasm;
            application/json json;
            application/zip zip whl;
        }
        default_type application/octet-stream;
        try_files $uri =404;
    }
}
