{
  "ciphertextRuntime": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject"
        ],
        "Resource": "arn:aws:s3:::REPLACE_CIPHERTEXT_BUCKET/*"
      },
      {
        "Effect": "Deny",
        "Action": [
          "s3:PutBucketPolicy",
          "s3:DeleteBucket",
          "s3:PutBucketPublicAccessBlock"
        ],
        "Resource": "arn:aws:s3:::REPLACE_CIPHERTEXT_BUCKET"
      }
    ]
  },
  "deletionLedgerRuntime": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Action": [
          "s3:ListBucket"
        ],
        "Resource": "arn:aws:s3:::REPLACE_LEDGER_BUCKET"
      },
      {
        "Effect": "Allow",
        "Action": [
          "s3:GetObject"
        ],
        "Resource": "arn:aws:s3:::REPLACE_LEDGER_BUCKET/*"
      },
      {
        "Effect": "Allow",
        "Action": [
          "s3:PutObject"
        ],
        "Resource": "arn:aws:s3:::REPLACE_LEDGER_BUCKET/*",
        "Condition": {
          "Null": {
            "s3:if-none-match": "false"
          }
        }
      },
      {
        "Effect": "Deny",
        "Action": [
          "s3:DeleteObject",
          "s3:DeleteObjectVersion",
          "s3:BypassGovernanceRetention"
        ],
        "Resource": "arn:aws:s3:::REPLACE_LEDGER_BUCKET/*"
      },
      {
        "Effect": "Deny",
        "Action": [
          "s3:DeleteBucket",
          "s3:PutLifecycleConfiguration",
          "s3:PutBucketPolicy",
          "s3:PutBucketVersioning",
          "s3:PutBucketObjectLockConfiguration",
          "s3:PutBucketPublicAccessBlock"
        ],
        "Resource": "arn:aws:s3:::REPLACE_LEDGER_BUCKET"
      }
    ]
  }
}
